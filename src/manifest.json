{
  "manifest_version": 3,
  "name": "Tabs to TXT",
  "version": "0.2.0",
  "description": "Saves the URLs of your open tabs to timestamped .txt files, on a schedule you choose. One file per window, all local.",
  "homepage_url": "https://github.com/YOUR_USER/tabs-to-txt",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabs-to-txt@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Tabs to TXT",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
