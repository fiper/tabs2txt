{
  "name": "tabs-to-txt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Firefox extension that saves the URLs of your open tabs to timestamped .txt files on a schedule.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USER/tabs-to-txt.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "web-ext run --source-dir src --browser-console",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint:js": "eslint .",
    "lint:format": "prettier --check .",
    "lint:ext": "web-ext lint --source-dir src",
    "lint": "npm run lint:js && npm run lint:format && npm run lint:ext",
    "format": "prettier --write .",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest",
    "icons": "python3 tools/make-icons.py",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "web-ext": "^8.3.0"
  },
  "lint-staged": {
    "*.{js,json,css,html,md,yml,yaml}": "prettier --write",
    "*.js": "eslint --fix"
  }
}
